# ──────────────────────────────────────────────────────────────────────────────
# Mesocosm UI — local dev env
#
# Copy to `.env.local` (gitignored) and tweak as needed. For GitHub Pages
# deploys, paste these key=value lines into the `ENV_FILE` repo secret; the
# deploy workflow writes them to `.env.local` before the production build.
# Vite only exposes variables prefixed with `VITE_`.
# ──────────────────────────────────────────────────────────────────────────────

# Bench API base URL.
#  - Local dev (no nginx): bench-api in swecc-core's docker compose binds to
#    host port BENCH_API_PORT (default 8010). Port 8000 is taken by
#    swecc-server.
#  - Local dev (with nginx): if you `docker compose --profile with-nginx up`
#    in swecc-core, the dev gateway proxies /bench/ → bench-api, so you can
#    use http://localhost/bench instead and mirror the prod layout.
#  - Production: api.swecc.org's nginx routes /bench/ → bench-api
#    (path-based; same cert/DNS as swecc-server — no extra subdomain).
#
# For prod deploys, set this in the GitHub Actions `ENV_FILE` secret to:
#   VITE_PUBLIC_API_BASE=https://api.swecc.org/bench
# With swecc-core nginx (`docker compose --profile with-nginx up`), use /bench so
# session auth and API docs share one origin. Requires ORCH_GATEWAY_PREFIX=/bench
# on bench-api (default in swecc-core compose).
VITE_PUBLIC_API_BASE=http://localhost/bench
# Direct bench-api only (no nginx): http://localhost:8010 and set ORCH_GATEWAY_PREFIX=
# empty in swecc-core/.env, then recreate bench-api.

# Django swecc-server for session auth (login / register / profile).
# Dev default: http://localhost:8000 — same as swecc-engagement.
# Production: https://api.swecc.org
# With nginx profile (recommended for mesocosm + working /docs):
VITE_AUTH_API_BASE=http://localhost
# Without nginx:
# VITE_AUTH_API_BASE=http://localhost:8000
#
# For cookies to reach the bench API in local dev, run swecc-core with the
# nginx profile so both /auth and /bench share one origin (see comment above).
#
# Set when bench-api runs without auth middleware (legacy local stack):
# VITE_BENCH_AUTH_DISABLED=1

# Optional: override the base path used by the static build (defaults are
# inferred from `package.json` → `homepage`). Useful when moving from the
# GitHub Pages project URL to a custom domain.
# VITE_BASE_PATH=/
